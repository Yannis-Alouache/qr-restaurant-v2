# =============================================================================
# Variables d'environnement de PRODUCTION — Menzo
# =============================================================================
# Référence à copier dans Coolify (Projet > votre application > Variables
# d'environnement > Sync depuis le compose, puis remplir chaque valeur).
# Ce fichier est un modèle : ne commitez jamais de vraies valeurs.
#
# Génération de secrets :
#   JWT_SECRET / POSTGRES_PASSWORD / SEAWEEDFS_* :
#     openssl rand -base64 48
# =============================================================================

# --- Domaines publics (champs « Domaine » dans Coolify) ----------------------
# Trois enregistrements DNS A pointant vers l'IP de votre VPS :
#   commander.votredomaine.fr  -> parcours client
#   admin.votredomaine.fr      -> back-office restaurateur
#   api.votredomaine.fr        -> API (webhooks Stripe, usage futur mobile)
# Dans Coolify, renseignez les variables SERVICE_FQDN_* avec ces URLs complètes
# (https:// inclus) ; TLS est émis automatiquement par le proxy de Coolify.
SERVICE_FQDN_CLIENT_80=https://commander.votredomaine.fr
SERVICE_FQDN_ADMIN_80=https://admin.votredomaine.fr
SERVICE_FQDN_API_8080=https://api.votredomaine.fr

# --- Base de données ----------------------------------------------------------
POSTGRES_DB=qr_restaurant
POSTGRES_USER=qr_user
# Générer : openssl rand -base64 48 (sans caractères posant problème à une URL
# JDBC si possible ; en cas de doute, alphanumérique uniquement)
POSTGRES_PASSWORD=A_REMPLACER

# --- Sécurité -----------------------------------------------------------------
# Obligatoire en prod : l'API refuse de démarrer sans secret fort.
JWT_SECRET=A_REMPLACER_openssl_rand_base64_48

# --- URLs publiques utilisées par l'API --------------------------------------
# Redirections Stripe, liens de réinitialisation, origines CORS/WebSocket.
# Doivent correspondre aux SERVICE_FQDN ci-dessus, https:// inclus.
CLIENT_BASE_URL=https://commander.votredomaine.fr
ADMIN_BASE_URL=https://admin.votredomaine.fr

# --- Stripe (clés LIVE) -------------------------------------------------------
# Dashboard Stripe > Developers > API keys (basculer en mode « Live »).
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
# Webhooks : Dashboard > Developers > Webhooks > Add endpoint
#   URL       : https://api.votredomaine.fr/api/webhooks/stripe
#   Événements: checkout.session.completed, account.updated
# (account.updated maintient le statut d'onboarding Stripe Connect des
#  restaurateurs — connexion du compte depuis l'admin, Paramètres.)
# Le secret d'endpoint (whsec_...) arrive par e-mail/dashboard après création.
# Sans lui, les commandes payées restent « en attente de paiement ».
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Identifiant we_... de l'endpoint : permet à l'API de vérifier au démarrage
# que la version d'API de l'endpoint correspond à celle du SDK.
STRIPE_WEBHOOK_ENDPOINT_ID=we_xxx
# Pays des comptes Stripe Connect Express créés pour les restaurateurs.
STRIPE_CONNECT_COUNTRY=FR

# --- Stockage images (SeaweedFS du stack, interne) ----------------------------
# Générer deux valeurs distinctes : openssl rand -hex 16
SEAWEEDFS_ACCESS_KEY=A_REMPLACER
SEAWEEDFS_SECRET_KEY=A_REMPLACER

# --- E-mail (relais SMTP) -----------------------------------------------------
# Le compte « mot de passe oublié » est inopérant sans SMTP joignable.
# Exemple Brevo (300 e-mails/jour gratuits) :
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=... (login SMTP Brevo)
#   MAIL_PASSWORD=... (clé SMTP Brevo)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=A_REMPLACER
MAIL_PASSWORD=A_REMPLACER
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Nom annoncé en EHLO : votre domaine API sans https:// de préférence.
MAIL_SMTP_EHLO_NAME=api.votredomaine.fr
# L'adresse doit être un expéditeur validé chez votre fournisseur SMTP.
MAIL_FROM=Menzo <no-reply@votredomaine.fr>

# --- Optionnel ----------------------------------------------------------------
# Durée de validité du lien de réinitialisation (minutes).
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Patterns d'origines CORS additionnels, séparés par des virgules. Inutile tant
# que les frontends sont servis sur leurs propres domaines (same-origin).
CORS_EXTRA_ORIGIN_PATTERNS=

# --- Connexion Google (optionnel) ----------------------------------------------
# Back-office restaurateur. Sans client-id, le bouton « Continuer avec Google »
# est masqué. Procédure pas à pas : docs/connexion-google.md
# Dans Google Cloud Console (APIs & Services > Credentials), créer
# un client OAuth 2.0 « Application Web » avec l'URI de redirection autorisée :
#   https://admin.votredomaine.fr/api/auth/oauth2/code/google
#GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=A_REMPLACER
# Doit correspondre EXACTEMENT à l'URI déclarée chez Google.
#GOOGLE_REDIRECT_URI=https://admin.votredomaine.fr/api/auth/oauth2/code/google
