# Database
POSTGRES_DB=qr_restaurant
POSTGRES_USER=qr_user
POSTGRES_PASSWORD=qr_password
DATABASE_URL=jdbc:postgresql://localhost:5432/qr_restaurant
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SeaweedFS
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=any
SEAWEEDFS_SECRET_KEY=any

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
# (La prod active jwt.cookie.secure=true par défaut ; aucun réglage nécessaire
# en local — le cookie sécurisé exige HTTPS.)

# Seed de démonstration (compte owner@test.com, restaurant Naia Burger) :
# désactivé par défaut — ne JAMAIS activer en production. Les tests API et la
# CI e2e l'activent explicitement.
SEED_DEMO_DATA=true

# App
CLIENT_BASE_URL=http://localhost:4300
ADMIN_BASE_URL=http://localhost:4200

APP_ENV=local
