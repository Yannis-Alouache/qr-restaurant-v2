# Database
POSTGRES_DB=qr_restaurant
POSTGRES_USER=qr_user
POSTGRES_PASSWORD=qr_password
DATABASE_URL=jdbc:postgresql://localhost:5432/qr_restaurant
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Stripe
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Pays des comptes Connect Express créés pour les restaurateurs (défaut : FR).
#STRIPE_CONNECT_COUNTRY=FR

# SeaweedFS
SEAWEEDFS_S3_ENDPOINT=http://localhost:8333
SEAWEEDFS_ACCESS_KEY=any
SEAWEEDFS_SECRET_KEY=any

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-in-production
# (La prod active jwt.cookie.secure=true par défaut ; aucun réglage nécessaire
# en local — le cookie sécurisé exige HTTPS.)

# Seed de démonstration (compte owner@test.com, restaurant Naia Burger) :
# désactivé par défaut — ne JAMAIS activer en production. Les tests API et la
# CI e2e l'activent explicitement.
SEED_DEMO_DATA=true

# App
CLIENT_BASE_URL=http://localhost:4300
ADMIN_BASE_URL=http://localhost:4200

# Mail (réinitialisation de mot de passe). Local : Mailpit du docker-compose
# (SMTP :1025, boîte visible sur http://localhost:8025). En prod, MAIL_HOST est
# obligatoire (le refus de démarrer sans SMTP est volontaire) et pointe vers un
# vrai relais SMTP avec authentification si besoin.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Nom annoncé en EHLO et dans le domaine du Message-ID. Important : sans cette
# valeur, Jakarta Mail résout le hostname local par DNS à chaque envoi (10-20 s
# de délai sur les postes au DNS lent).
MAIL_SMTP_EHLO_NAME=qr-restaurant-api
MAIL_FROM=Menzo <no-reply@qr-restaurant.local>
# Local uniquement : en cas d'échec d'envoi, journalise le lien de reset dans
# les logs API pour finir le parcours sans serveur mail. Toujours false en prod.
MAIL_LOG_RESET_LINKS=true
# Durée de validité du lien de réinitialisation (minutes).
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Connexion Google (back-office restaurateur, optionnel). Sans client-id, la
# fonctionnalité est désactivée et le bouton « Continuer avec Google » est masqué.
# Procédure pas à pas : docs/connexion-google.md
# Créer un client OAuth 2.0 dans Google Cloud Console (APIs & Services >
# Credentials), type « Application Web », avec en URI de redirection autorisée :
#   http://localhost:4200/api/auth/oauth2/code/google
# (en production : https://admin.<votre-domaine>/api/auth/oauth2/code/google)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à l'URI déclarée chez Google.
#GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/oauth2/code/google

# Monitoring des erreurs (Sentry). Optionnel en dev : sans DSN, le SDK reste
# inactif. Procédure pas à pas (compte gratuit, alertes e-mail) :
#   docs/deploiement/monitoring.md
#SENTRY_DSN=

APP_ENV=local
